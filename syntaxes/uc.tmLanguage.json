{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.uc",
  "name": "ND Microcode (NORD-10, ND-100/110/120, ND-500, ND-5000)",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#addressMarker"
    },
    {
      "include": "#nd120Only"
    },
    {
      "include": "#opcodes"
    },
    {
      "include": "#wideModels"
    },
    {
      "include": "#end"
    },
    {
      "include": "#numerics"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "(%).*$",
          "name": "comment.line.percent.uc"
        },
        {
          "match": "(?<=^|\\s)#(?=\\s|$|[A-Za-z]).*$",
          "name": "comment.line.hash.uc"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "^\\s*(?:[0-7]+/\\s*)?([A-Za-z_][A-Za-z0-9_.$]*):",
          "name": "entity.name.function.label.uc"
        },
        {
          "match": "^\\s*(?:[0-7]{4}:?\\s*(?:[0-9A-Fa-f]{8}\\s+)?)?([A-Za-z][A-Za-z0-9_]*),(?=\\s|$)",
          "name": "entity.name.function.label.uc"
        }
      ]
    },
    "addressMarker": {
      "patterns": [
        {
          "match": "^\\s*([0-7]+)/",
          "name": "entity.name.section.address.uc"
        },
        {
          "match": "^\\s*([0-7]{4}):",
          "name": "entity.name.section.address.uc"
        }
      ]
    },
    "end": {
      "patterns": [
        {
          "match": ";",
          "name": "punctuation.terminator.statement.uc"
        }
      ]
    },
    "nd120Only": {
      "patterns": [
        {
          "match": "\\b(?:COMM,UART,STATUS|COMM,UART,DATA|COMM,UART,MODE|COMM,UART,COM|COMM,XSLOW|COMM,SLOW|COMM,MACL|IDBS,PICM|IDBS,UART|AB,OLD303|AB,NOISE|AB,BAUD)\\b",
          "name": "keyword.other.nd120-only.uc"
        }
      ]
    },
