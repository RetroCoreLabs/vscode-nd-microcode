{
  "name": "nd-microcode",
  "displayName": "ND Microcode (NORD-10, ND-100/110/120, ND-500, ND-5000)",
  "description": "Highlighting, hover, assemble and disassemble for NORD-10, ND-100, ND-110, ND-120, ND-500 and ND-5000 microcode (.uc) files",
  "version": "0.2.1",
  "publisher": "nd100uc",
  "license": "MIT",
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RetroCoreLabs/nd-microcode.git"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:uc",
    "onCommand:nd-microcode.assembleCurrent",
    "onCommand:nd-microcode.assembleAndSplit",
    "onCommand:nd-microcode.disassembleBinary",
    "onCommand:nd-microcode.assembleLine",
    "onCommand:nd-microcode.openBitView",
    "onCommand:nd-microcode.setModel",
    "onCommand:nd-microcode.checkFile"
  ],
  "contributes": {
    "languages": [
      {
        "id": "uc",
        "aliases": [
          "ND MicroCode",
          "NORD-10 MicroCode",
          "ND-100 MicroCode",
          "ND-110 MicroCode",
          "ND-120 MicroCode",
          "ND-500 MicroCode",
          "ND-5000 MicroCode",
          "uc"
        ],
        "extensions": [
          ".uc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "uc",
        "scopeName": "source.uc",
        "path": "./syntaxes/uc.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "nd-microcode.assembleCurrent",
        "title": "Assemble current .uc file (native image of its variant)",
        "category": "ND Microcode"
      },
      {
        "command": "nd-microcode.assembleAndSplit",
        "title": "Assemble and split into ROM chip images",
        "category": "ND Microcode"
      },
      {
        "command": "nd-microcode.disassembleBinary",
        "title": "Import binary image (.CODE / .DATA / .hex) and disassemble to .uc",
        "category": "ND Microcode"
      },
      {
        "command": "nd-microcode.assembleLine",
        "title": "Show assembled bits for current instruction",
        "category": "ND Microcode"
      },
      {
        "command": "nd-microcode.openBitView",
        "title": "Open live bit-breakdown view",
        "category": "ND Microcode"
      },
      {
        "command": "nd-microcode.setModel",
        "title": "Set variant for this file",
        "category": "ND Microcode"
      },
      {
        "command": "nd-microcode.checkFile",
        "title": "Check this file (show assembler messages)",
        "category": "ND Microcode"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "nd-microcode.assembleCurrent",
          "when": "editorLangId == uc",
          "group": "nd-microcode@1"
        },
        {
          "command": "nd-microcode.assembleAndSplit",
          "when": "editorLangId == uc",
          "group": "nd-microcode@2"
        },
        {
          "command": "nd-microcode.assembleLine",
          "when": "editorLangId == uc",
          "group": "nd-microcode@3"
        },
        {
          "command": "nd-microcode.openBitView",
          "when": "editorLangId == uc",
          "group": "nd-microcode@4"
        },
        {
          "command": "nd-microcode.setModel",
          "when": "editorLangId == uc",
          "group": "nd-microcode@5"
        }
      ]
    },
    "configuration": {
      "title": "ND Microcode",
      "properties": {
        "nd-microcode.hover.showEncoding": {
          "type": "boolean",
          "default": true,
          "description": "Show the raw octal encoding (w1-w4) in hover tooltips."
        },
        "nd-microcode.hover.showModelWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Highlight ND-120-only tokens in hover tooltips."
        },
        "nd-microcode.defaultModel": {
          "type": "string",
          "enum": [
            "nd10",
            "nd100",
            "nd110",
            "nd120",
            "nd120-dly",
            "nd500",
            "nd5000"
          ],
          "default": "nd110",
          "description": "Variant used when a file has no %#MODEL line, no matching nd-microcode.fileModels entry and the words in the file do not settle it."
        },
        "nd-microcode.fileModels": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "description": "Variant name: nd10, nd100, nd110, nd120, nd120-dly, nd500, nd5000 (also nord10, nd-500 and so on)."
          },
          "markdownDescription": "Variant per file. Key: file pattern relative to the workspace folder (`*.uc` matches the file name, `src/**/*.uc` the path); value: variant name. The first matching entry wins. A `%#MODEL` line in the file wins over this setting."
        },
        "nd-microcode.autodetect.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Guess the variant from the words in the file when no %#MODEL line and no fileModels entry applies. The guess is only shown in the status bar; it is never written to the file."
        },
        "nd-microcode.diagnostics.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Assemble the file when it is saved and show the assembler messages in the editor."
        }
      }
    },
    "configurationDefaults": {
      "[uc]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenTypes": [
      {
        "id": "ucUnknown",
        "superType": "string",
        "description": "A word that is not a token, number, label or field of the variant of the file"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "uc",
        "scopes": {
          "ucUnknown": [
            "invalid.illegal"
          ]
        }
      }
    ]
  },
  "scripts": {
    "generate": "node scripts/generate-hover-data.mjs && node scripts/snapshot-defs.mjs",
    "compile": "tsc -p ./",
    "bundle": "node scripts/build-bundle.mjs",
    "watch": "tsc -watch -p ./",
    "build": "npm run generate && npm run compile && npm run bundle",
    "package": "npm run build && vsce package -o nd-microcode.vsix"
  },
  "dependencies": {
    "@nd100uc/microcode": "file:external/meta/lib/ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.73.0",
    "@vscode/vsce": "^3.9.0",
    "esbuild": "^0.28.0",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.0"
  }
}
